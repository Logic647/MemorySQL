{
  "name": "@logic647/tools-memorysql",
  "version": "0.2.0",
  "description": "装进 magpie 就能用的跨 agent 会话档案与项目交接：内置 SQLite 知识库、10 个记忆/会话工具、网关自动续接、会话回写和 MemorySQL 页面。No separate app needed: a built-in SQLite knowledge base, 10 tools, automatic recall, conversation capture and a MemorySQL page.",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "hooks.mjs",
    "service.mjs",
    "lib",
    "page",
    "ui",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-tools",
    "magpie-page",
    "magpie-plugin",
    "mcp",
    "memory",
    "memorysql",
    "opencode",
    "opencode-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Logic647/MemorySQL.git",
    "directory": "magpie-plugin"
  },
  "engines": {
    "magpie": ">=0.1.1531",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "test": "node --test"
  },
  "magpie": {
    "name": "MemorySQL",
    "icon": "page/icon.svg",
    "summary": {
      "en": "Cross-agent session archive and project handoff inside magpie, with its own local SQLite knowledge base: 10 memory tools, automatic recall at the gateway, conversation capture, and a MemorySQL page. No separate app needed.",
      "zh": "装进 magpie 就能用的跨 agent 会话档案与项目交接：插件自带本地 SQLite 知识库，提供 10 个记忆/会话工具、网关自动续接、会话回写和 MemorySQL 页面，不需要另装 MemorySQL 应用。"
    },
    "hooks": "./hooks.mjs",
    "options": {
      "backend": "embedded",
      "dataDir": "",
      "port": 8642,
      "endpoint": "",
      "readOnly": false,
      "recall": true,
      "maxBytes": 6000,
      "gatewayTimeoutMs": 1500,
      "skipAgents": [],
      "skipSubagents": true,
      "recallRemote": false,
      "captureRemote": false,
      "pagePort": 3488
    },
    "page": {
      "title": "MemorySQL",
      "titles": {
        "zh": "MemorySQL",
        "zh-TW": "MemorySQL",
        "ja": "MemorySQL"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "service": {
        "port": 3488,
        "option": "pagePort"
      }
    },
    "actions": [
      {
        "id": "agent-sessions",
        "menu": "agent",
        "title": "MemorySQL sessions",
        "titles": {
          "zh": "在 MemorySQL 里看会话",
          "zh-TW": "在 MemorySQL 裡看會話",
          "ja": "MemorySQL のセッション"
        }
      }
    ]
  }
}
